{
  "name": "bitcoin-mov",
  "version": "0.1.0",
  "private": true,
  "description": "A crowd-sourced list of Bitcoin movies, documentaries and videos, powered by Nostr (kind 31888, described by a kind 31889 schema event).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "serve": "npx serve out",
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mjs",
    "seed:dry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mjs --dry-run",
    "seed:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/schema.mjs",
    "seed:suggestions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-suggestions.mjs",
    "seed:curated": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-curated.mjs",
    "schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/schema.mjs",
    "schema:dry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/schema.mjs --dry-run",
    "curate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curate.mjs",
    "verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify.mjs"
  },
  "dependencies": {
    "next": "^15.1.0",
    "nostr-tools": "^2.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
